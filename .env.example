NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional local-only read-only demo mode. Leave disabled for real Supabase work.
ENABLE_LOCAL_DEMO=0

# Private Supabase Storage buckets created by the migrations.
SUPABASE_STORAGE_BUCKET=fleet-documents
SUPABASE_ASSET_IMAGES_BUCKET=asset-images
SUPABASE_MAINTENANCE_ATTACHMENTS_BUCKET=maintenance-attachments
SUPABASE_COMPLIANCE_DOCUMENTS_BUCKET=compliance-documents
DOCUMENT_UPLOAD_MAX_SIZE_BYTES=10485760

# Required before enabling scheduled reminder processing.
CRON_SECRET=

# Transactional reminder delivery. Use EMAIL_PROVIDER=none locally.
EMAIL_PROVIDER=none
EMAIL_FROM=
SUPPORT_EMAIL=
RESEND_API_KEY=

# Redis-compatible rate limiting. Required for production abuse protection.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_KEY_SALT=

# Server-only FleetReady Inbox AI extraction. Use AI_INGESTION_PROVIDER=none
# to keep uploads/manual fallback available without calling OpenAI.
AI_INGESTION_PROVIDER=none
OPENAI_API_KEY=
OPENAI_INGESTION_MODEL=gpt-4o-mini

# Stripe test-mode billing. Use test keys and test price IDs only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_SMALL_FLEET_PRICE_ID=
STRIPE_GROWING_FLEET_PRICE_ID=

# Development-only demo data seeding. Never set these in production.
DEMO_SEED_ALLOW=
DEMO_SEED_RESET=
DEMO_SEED_METADATA_ONLY=
DEMO_OWNER_PASSWORD=
